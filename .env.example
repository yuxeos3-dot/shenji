# 服务配置
PORT=8088
DATA_DIR=./data
# PostgreSQL 连接 URL —— 必填
# 例：DATABASE_URL=postgres://user:pass@localhost:5432/seo?sslmode=disable
DATABASE_URL=

# JWT 密钥 —— 必填，至少 16 字符。生成命令：openssl rand -hex 32
# 如果不设置或过短，后端启动时会直接 log.Fatal。
JWT_SECRET=
n# CSRF 独立密钥 —— 可选，但强烈推荐。如果 JWT_SECRET 泄露，独立的 CSRF
# 密钥可确保 CSRF 保护不受影响。生成命令：openssl rand -hex 32
# 如果不设置，系统会从 JWT_SECRET 派生 CSRF key（向后兼容）。
CSRF_SECRET=

# CORS 白名单（逗号分隔，生产环境强烈建议设置）。留空=允许任意来源。
# 例：ALLOWED_ORIGINS=https://keifukudo.com,https://www.keifukudo.com
ALLOWED_ORIGINS=

# 首次启动创建 admin 账号的初始密码。留空=随机生成并在日志中一次性打印。
ADMIN_INIT_PASSWORD=

# ┌─────────────────────────────────────────────────────────────────┐
# │  WARNING / 警告: ALLOW_PRIVATE_FETCH                           │
# │                                                                 │
# │  Setting this to "true" disables SSRF protection and allows    │
# │  the server to fetch internal/private network addresses.        │
# │  This is a SEVERE SECURITY RISK in production.                  │
# │                                                                 │
# │  ONLY enable for local development. NEVER in production.        │
# │  将此项设为 true 会关闭 SSRF 防护，允许服务端访问内网地址。     │
# │  仅限本地开发使用，生产环境绝对不要启用！                       │
# └─────────────────────────────────────────────────────────────────┘
ALLOW_PRIVATE_FETCH=

# AI 接口（初始值，可在后台设置覆盖）
AI_API_URL=https://ai.router.team/v1
AI_API_KEY=your-api-key
AI_MODEL=claude-sonnet-4-6

# Telegram（初始值，可在后台设置覆盖）
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Google OAuth
GSC_CLIENT_ID=your-gsc-client-id
GSC_CLIENT_SECRET=your-gsc-client-secret
GSC_REDIRECT_URI=https://your-domain.com/api/v1/oauth/gsc/callback

# Yandex OAuth
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
