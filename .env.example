# ── 服务 ─────────────────────────────────────────────────────────────
PORT=8088

# PostgreSQL 连接 URL（必填）
# 例：DATABASE_URL=postgres://user:pass@localhost:5432/seo?sslmode=disable
DATABASE_URL=

# ── 鉴权 ─────────────────────────────────────────────────────────────
# 单用户登录密码（必填）。前端登录页只填这一个值。
APP_PASSWORD=change-me

# JWT 签名密钥（必填，至少 16 字符）。给登录后下发的 cookie 用。
# 生成：openssl rand -hex 32
JWT_SECRET=

# CSRF 独立密钥（可选，推荐）。留空时从 JWT_SECRET 派生。
# 生成：openssl rand -hex 32
CSRF_SECRET=

# 信任的反向代理 IP（逗号分隔）。默认只信 127.0.0.1 / ::1，
# 部署在 Cloudflare / nginx 后面时填上代理 IP，否则 c.ClientIP() 会被伪造。
TRUSTED_PROXIES=

# CORS 白名单（逗号分隔）。空 = 允许任意来源。生产建议填实际域名。
# 例：ALLOWED_ORIGINS=https://example.com
ALLOWED_ORIGINS=

# ── SSRF 防护开关 ────────────────────────────────────────────────────
# true = 关闭 SSRF 防护，允许服务端访问内网。生产 *绝对不要* 启用。
ALLOW_PRIVATE_FETCH=

# ── AI / 平台凭据 ────────────────────────────────────────────────────
# 这些通常在登录后通过「系统设置」页面配置；环境变量是首次启动的种子值。
AI_API_URL=https://ai.router.team/v1
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Google OAuth — 在 https://console.cloud.google.com 创建 Web 应用
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=https://your-domain.com/api/v1/oauth/gsc/callback

# Yandex OAuth — 在 https://oauth.yandex.com 创建应用
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
